<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Gas"
    android:orientation="vertical"
   >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <ImageView

            android:id="@+id/imageView2"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/profile"
            tools:ignore="MissingConstraints"
            />

        <TextView
            android:layout_width="200dp"
            android:layout_height="70dp"
            android:id="@+id/elctric_user_name_card"
            android:gravity="center"
            android:text="Ahmed Mohamed Shaban"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginLeft="25dp"

            />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginLeft="55dp"
            android:src="@drawable/logo"
            />

    </LinearLayout>



    <TextView
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:text="electricity"
        android:layout_marginLeft="150dp"
        android:layout_marginTop="100dp"
        android:textStyle="bold"
        android:textSize="30sp"
        android:textColor="@color/black"

        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="10dp"
        android:text="services provider"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Spinner
        android:layout_width="320dp"
        android:layout_height="68dp"
        android:layout_marginTop="0dp"
        android:layout_marginLeft="20dp"
        android:background="@color/smawy"
        android:textSize="24sp"
        android:textStyle="bold"
        android:entries="@array/Electricity_list"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="10dp"
        android:text="services number"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:layout_width="320dp"
        android:layout_height="68dp"
        android:layout_marginTop="0dp"
        android:layout_marginLeft="20dp"
        android:background="@color/smawy"
        android:textSize="24sp"
        android:textStyle="bold"
        android:id="@+id/servecnuber"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="10dp"
        android:text="Amount"
        android:textSize="20sp"
        android:textStyle="bold" />
    <EditText
        android:layout_width="320dp"
        android:layout_height="68dp"
        android:layout_marginTop="0dp"
        android:id="@+id/electric_amount"
        android:layout_marginLeft="20dp"
        android:background="@color/smawy"
        android:textSize="24sp"
        android:textStyle="bold" />



    <Button
        android:layout_width="150dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:layout_marginTop="120dp"
        android:id="@+id/electric_pay_button"
        android:text="Transfer"
        android:textSize="30sp"
        android:textStyle="bold"
        android:backgroundTint="@color/green"
        />




</LinearLayout>
